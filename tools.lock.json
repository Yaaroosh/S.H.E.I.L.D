{
    "nodejs": {
        "min_version": "18",
        "recommended_version": "20"
    },

    "codeql": {
        "repo": "github/codeql-cli-binaries",
        "tag": "v2.22.4",
        "asset": "codeql-win64.zip",
        "entry_exe": "codeql\\codeql.exe"
    },
    
    "zap": {
        "repo": "zaproxy/zap-archive",
        "tag": "zap-v2.15.0",
        "asset": "ZAP_2.15.0_Crossplatform.zip",
        "entry_bat": "zap.bat"
    },

    "ffuf": {
        "repo": "ffuf/ffuf",
        "tag": "v2.1.0",
        "asset": "ffuf_2.1.0_windows_amd64.zip",
        "entry_exe": "ffuf.exe",
        "default_wordlist_url": "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt",
        "default_wordlist_path": "wordlists\\common.txt"
    }

}